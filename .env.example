# Copy this file to .env and fill in the keys you need.
# Never commit .env to version control.

# Default LLM provider: mock | gemini | claude
HOME_1_LLM_PROVIDER=mock

# Optional model override (defaults come from config/default.yaml)
# HOME_1_MODEL=gemini-2.5-flash

# Optional embodiment mode: null | console
HOME_1_EMBODIMENT=console

# Google Gemini API key (required when HOME_1_LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# Anthropic Claude API key (required when HOME_1_LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=
